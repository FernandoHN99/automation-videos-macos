{
  "pipeline": {
    "home": "my-videos",
    "copy_non_video": true,
    "file_stability_seconds": 180,
    "max_encode_attempts": 3,
    "archive_originals": true,
    "extensions": [".mp4", ".mov", ".mkv", ".m4v", ".webm"],
    "dry_run": false,
    "prevent_sleep": true,
    "wait_for_stable": true,
    "poll_seconds": 15
  },
  "encoding": {
    "default_profile": "compact",
    "profiles": {
      "quality":  { "crf": 18, "preset": "medium" },
      "balanced": { "crf": 20, "preset": "medium" },
      "compact":  { "crf": 23, "preset": "medium" }
    },
    "pixel_format": "yuv420p",
    "audio_bitrate": "128k",
    "minimum_savings_percent": 15,
    "faststart": true,
    "nice": 10,
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe"
  }
}
