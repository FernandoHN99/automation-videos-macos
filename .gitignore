# --- Vídeos e dados de trabalho: nunca versionar ---
my-videos/*/*
!my-videos/*/.gitkeep
*.mp4
*.mkv
*.mov
*.m4v
*.webm

# --- Estado de execução ---
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.log
*.lock

# --- Segredos (a chave SSH fica em ~/.ssh, fora do repo, mas por garantia) ---
*.pem
*_ed25519
*_rsa
.env

# --- Python / macOS / editor / Claude Code local ---
__pycache__/
*.pyc
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
